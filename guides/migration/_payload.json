ents, nested placeholders (",[153,983,430],{},[931,985,986,987,990],{},"Acks from the server answered (",[153,988,989],{},"Event::ack",", ACK and BINARY_ACK); awaitable acks with timeout.",[931,992,993,994,715],{},"The socket.io-client backoff (jitter 0.5, delay before every attempt), ",[153,995,996],{},"randomization_factor",[931,998,999,1000,337,1003,259,1006,739],{},"Connection state recovery (",[153,1001,1002],{},"pid",[153,1004,1005],{},"offset",[153,1007,1008],{},"recovered",[931,1010,1011,1012,259,1015,259,1018,1021],{},"Typed ",[153,1013,1014],{},"ConnectionState",[153,1016,1017],{},"DisconnectReason",[153,1019,1020],{},"LinkInfo","; tracing with redaction; packet inspector.",[931,1023,1024,1025,337,1027,337,1030,337,1033,337,1036,1039],{},"Runtime ",[153,1026,607],{},[153,1028,1029],{},"once",[153,1031,1032],{},"off",[153,1034,1035],{},"on_any",[153,1037,1038],{},"listener_count","; handlers without boxing; panics contained.",[931,1041,1042],{},"TLS backend as a feature (rustls default, native-tls, none), private CAs, OS trust store.",[931,1044,1045,1046,1049],{},"Per-attempt query and headers, cookies, HTTP proxies, ",[153,1047,1048],{},"reconnect()"," after close.",[931,1051,1052,1054],{},[153,1053,208],{}," API on top of the async client (one implementation).",[931,1056,1057],{},"Differential tests against socket.io-client 4.8 on the wire.",[1059,1060,1061],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl,