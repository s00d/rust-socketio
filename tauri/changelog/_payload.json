-api"," (npm)\nare documented in this file. Both are released together with the same version.",[135,148,149,150,157,158,163],{},"The format is based on ",[151,152,156],"a",{"href":153,"rel":154},"https:\u002F\u002Fkeepachangelog.com\u002Fen\u002F1.1.0\u002F",[155],"nofollow","Keep a Changelog",",\nand this project adheres to ",[151,159,162],{"href":160,"rel":161},"https:\u002F\u002Fsemver.org\u002Fspec\u002Fv2.0.0.html",[155],"Semantic Versioning",".",[165,166,168],"h2",{"id":167},"unreleased",[169,170,171],"span",{},"Unreleased",[173,174,176],"h3",{"id":175},"changed","Changed",[178,179,180],"ul",{},[181,182,183,184,188],"li",{},"Documentation at ",[151,185,186],{"href":186,"rel":187},"https:\u002F\u002Fs00d.github.io\u002Frust-socketio\u002Ftauri\u002Fsetup",[155],"; the README is short\nand links to it.",[165,190,192,195],{"id":191},"_010-2026-11-08",[169,193,194],{},"0.1.0"," - 2026-11-08",[173,197,199],{"id":198},"added","Added",[178,201,202,205,256,318,321,328,334,347,357,371,377,411,449,468,481,493,504,511,521],{},[181,203,204],{},"First release: a registry of named socketio-next clients shared by Rust and the webviews.",[181,206,207,208,211,212,215,216,219,220,223,224,227,228,231,232,219,235,219,238,219,241,244,245,227,248,251,252,255],{},"Rust: ",[139,209,210],{},"SocketIoExt::socketio()"," → ",[139,213,214],{},"SocketIo"," with ",[139,217,218],{},"connect",", ",[139,221,222],{},"insert"," (",[139,225,226],{},"Access::Full"," \u002F\n",[139,229,230],{},"Access::ReadOnly","), ",[139,233,234],{},"get",[139,236,237],{},"access",[139,239,240],{},"ids",[139,242,243],{},"remove"," (never disconnects), ",[139,246,247],{},"subscribe",[139,249,250],{},"unsubscribe",". Ids are unique (",[139,253,254],{},"AlreadyExists",", no silent replacement).",[181,257,258,259,219,261,219,264,267,268,215,271,219,274,219,277,280,281,280,284,227,287,280,290,219,293,219,296,219,299,219,302,219,305,219,308,219,311,314,315,163],{},"JS: ",[139,260,218],{},[139,262,263],{},"attach",[139,265,266],{},"list","; ",[139,269,270],{},"Socket",[139,272,273],{},"emit",[139,275,276],{},"emitWithAck",[139,278,279],{},"on"," \u002F ",[139,282,283],{},"once",[139,285,286],{},"off",[139,288,289],{},"onAny",[139,291,292],{},"offAny",[139,294,295],{},"onState",[139,297,298],{},"state",[139,300,301],{},"linkInfo",[139,303,304],{},"connected",[139,306,307],{},"id",[139,309,310],{},"disconnect",[139,312,313],{},"close",";\ntyped ",[139,316,317],{},"SocketIoError { kind, message, data }",[181,319,320],{},"Per-subscription IPC channels (ordered, per webview) with an optional event filter; ended on\nunsubscribe, on a failed send, when the webview loads a new page or its window is destroyed,\nand when the client is removed.",[181,322,323,324,327],{},"Server acks answered from JS: one ",[139,325,326],{},"ackId"," per server ack for every subscribed webview,\nanswered once; 2 min TTL and a budget per webview; not offered for read-only clients or once a\ndisconnect started.",[181,329,330,333],{},[139,331,332],{},"SocketIo::reserve(id)",": ids Rust registers later cannot be taken by a page script.",[181,335,336,339,340,343,344,163],{},[139,337,338],{},"Builder::allow_url_prefix",": URL allow-list for webview connects (the CSP does not cover\nthese sockets); ",[139,341,342],{},"init()"," is ",[139,345,346],{},"Builder::new().build()",[181,348,349,350,352,353,356],{},"Webview isolation: ",[139,351,250],{}," and ",[139,354,355],{},"ack"," act only on the caller's subscriptions and acks;\nat most 64 subscriptions per webview.",[181,358,359,280,361,363,364,366,367,370],{},[139,360,218],{},[139,362,263],{}," resolve with the current state (the socket is ",[139,365,304],{}," right away);\nthe channel starts with that snapshot (",[139,368,369],{},"snapshot: true",") and nothing older follows it.",[181,372,373,374,376],{},"One forwarding hub per client: ending a subscription drops its channel; a reload during a\nJS ",[139,375,218],{}," leaves no subscription behind.",[181,378,379,280,382,280,385,388,389,219,392,219,395,398,399,402,403,406,407,410],{},[139,380,381],{},"setAuth",[139,383,384],{},"setHeaders",[139,386,387],{},"setQuery"," (commands ",[139,390,391],{},"set_auth",[139,393,394],{},"set_headers",[139,396,397],{},"set_query",") for\nclients a webview connected, read before every connect attempt; ",[139,400,401],{},"reconnect"," after ",[139,404,405],{},"closed",";\na ",[139,408,409],{},"ca"," option (PEM) for private CAs.",[181,412,413,415,416,280,419,219,422,280,425,219,428,267,431,434,435,215,438,441,442,445,446,163],{},[139,414,301],{}," has ",[139,417,418],{},"packetsIn",[139,420,421],{},"packetsOut",[139,423,424],{},"bytesIn",[139,426,427],{},"bytesOut",[139,429,430],{},"sessions",[139,432,433],{},"disconnected","\nstates carry the error (",[139,436,437],{},"WebsocketClosed",[139,439,440],{},"data: { code, reason }","); ",[139,443,444],{},"HttpStatus","\nerrors have ",[139,447,448],{},"data.message",[181,450,451,452,454,455,219,458,219,461,219,464,467],{},"The URL allow-list checks the engine.io path the connection uses (not the URL path, which\nis the namespace); concurrent connects hold their id and subscription slot, so they cannot\npass the per-webview cap; ",[139,453,401],{}," only for clients a webview connected; headers the\nwebview may not set (",[139,456,457],{},"Host",[139,459,460],{},"Cookie",[139,462,463],{},"Sec-WebSocket-*",[139,465,466],{},"Proxy-*",", ...).",[181,469,470,471,219,474,477,478,163],{},"The URL allow-list compares the URL socketio-next really builds (dot segments resolved) and\nrefuses ",[139,472,473],{},"..",[139,475,476],{},"%2e"," and backslashes in ",[139,479,480],{},"path",[181,482,483,352,486,489,490,163],{},[139,484,485],{},"State",[139,487,488],{},"Message"," and their struct-like variants are ",[139,491,492],{},"#[non_exhaustive]",[181,494,495,496,499,500,503],{},"Typed ",[139,497,498],{},"InvalidOptions"," for wrong option types\u002Fvalues (values are not echoed); connect\noptions' ",[139,501,502],{},"Debug"," hides query, header and auth values.",[181,505,506,507,510],{},"Binary arguments both ways (",[139,508,509],{},"Uint8Array"," ↔ socket.io attachments).",[181,512,513,514,517,518,163],{},"Permissions per command, ",[139,515,516],{},"socketio:allow-read"," (observe only) and ",[139,519,520],{},"socketio:default",[181,522,523,524,527,528,531],{},"Features ",[139,525,526],{},"rustls"," (default) and ",[139,529,530],{},"native-tls",", forwarded to socketio-next.",{"title":533,"searchDepth":534,"depth":535,"links":536},"",2,3,[537,540],{"id":167,"depth":534,"text":171,"children":538},[539],{"id":175,"depth":535,"text":176},{"id":191,"depth":534,"text":541,"children":542},"0.1.0 - 2026-11-08",[543],{"id":198,"depth":535,"text":199},"All notable changes to tauri-plugin-socketio and tauri-plugin-socketio-api.","md",null,{},true,{"title":104,"description":544},"aUgPWISdreys20QXm3yK66TMguzn_Og1dOxKjmN5WDU",[552,554],{"title":100,"path":101,"stem":102,"description":553,"children":-1},"A Tauri app with a read-only client owned by Rust and a client of the webview.",{"title":114,"path":115,"stem":116,"description":555,"children":-1},"What changed from rust_socketio 0.6, the fixes and additions, and a mapping table.",1794148412206]