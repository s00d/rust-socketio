87,91,95,99,103],{"title":72,"path":73,"stem":74},"Setup","\u002Ftauri\u002Fsetup","3.tauri\u002F1.setup",{"title":76,"path":77,"stem":78},"JavaScript API","\u002Ftauri\u002Fjavascript-api","3.tauri\u002F2.javascript-api",{"title":80,"path":81,"stem":82},"Rust API","\u002Ftauri\u002Frust-api","3.tauri\u002F3.rust-api",{"title":84,"path":85,"stem":86},"Permissions","\u002Ftauri\u002Fpermissions","3.tauri\u002F4.permissions",{"title":88,"path":89,"stem":90},"Security","\u002Ftauri\u002Fsecurity","3.tauri\u002F5.security",{"title":92,"path":93,"stem":94},"Messages and errors","\u002Ftauri\u002Fmessages-and-errors","3.tauri\u002F6.messages-and-errors",{"title":96,"path":97,"stem":98},"Troubleshooting","\u002Ftauri\u002Ftroubleshooting","3.tauri\u002F7.troubleshooting",{"title":100,"path":101,"stem":102},"Example app","\u002Ftauri\u002Fexample","3.tauri\u002F8.example",{"title":104,"path":105,"stem":106},"Plugin changelog","\u002Ftauri\u002Fchangelog","3.tauri\u002F9.changelog",{"title":108,"icon":109,"path":110,"stem":111,"children":112,"page":26},"Guides","i-lucide-book-open","\u002Fguides","4.guides",[113,117,121],{"title":114,"path":115,"stem":116},"Migration from rust_socketio","\u002Fguides\u002Fmigration","4.guides\u002F1.migration",{"title":118,"path":119,"stem":120},"Comparison","\u002Fguides\u002Fcomparison","4.guides\u002F2.comparison",{"title":122,"path":123,"stem":124},"Contributing","\u002Fguides\u002Fcontributing","4.guides\u002F3.contributing",{"title":126,"path":127,"stem":128},"Changelog","\u002Fchangelog","9.changelog",{"id":130,"title":104,"body":131,"description":761,"extension":762,"links":763,"meta":764,"navigation":765,"path":105,"seo":766,"stem":106,"__hash__":767},"docs\u002F3.tauri\u002F9.changelog.md",{"type":132,"value":133,"toc":739},"minimark",[134,147,164,172,179,184,191,197,200,244,248,272,276,342,346,360,363,407,414,418],[135,136,137,138,142,143,146],"p",{},"All notable changes to ",[139,140,141],"code",{},"tauri-plugin-socketio"," (crate) and ",[139,144,145],{},"tauri-plugin-socketio-api"," (npm)\nare documented in this file. Both are released together with the same version.",[135,148,149,150,157,158,163],{},"The format is based on ",[151,152,156],"a",{"href":153,"rel":154},"https:\u002F\u002Fkeepachangelog.com\u002Fen\u002F1.1.0\u002F",[155],"nofollow","Keep a Changelog",",\nand this project adheres to ",[151,159,162],{"href":160,"rel":161},"https:\u002F\u002Fsemver.org\u002Fspec\u002Fv2.0.0.html",[155],"Semantic Versioning",".",[165,166,168],"h2",{"id":167},"unreleased",[169,170,171],"span",{},"Unreleased",[165,173,175,178],{"id":174},"_021-2026-11-21",[169,176,177],{},"0.2.1"," - 2026-11-21",[180,181,183],"h3",{"id":182},"changed","Changed",[185,186,187],"ul",{},[188,189,190],"li",{},"Built on socketio-next 0.2.1.",[165,192,194,178],{"id":193},"_020-2026-11-21",[169,195,196],{},"0.2.0",[180,198,88],{"id":199},"security",[185,201,202,220],{},[188,203,204,205,208,209,208,212,215,216,219],{},"A webview may not set the ",[139,206,207],{},"Origin",", ",[139,210,211],{},"Forwarded",[139,213,214],{},"X-Forwarded-*"," and ",[139,217,218],{},"X-Real-IP"," headers\n(a page could pose as another origin or client address to the server).",[188,221,222,223,208,226,229,230,208,233,208,236,239,240,243],{},"A webview's query can no longer override engine.io's own parameters (",[139,224,225],{},"sid",[139,227,228],{},"EIO",",\n",[139,231,232],{},"transport",[139,234,235],{},"t",[139,237,238],{},"b64","): with a read-only client's engine sid from ",[139,241,242],{},"linkInfo",", a page could\ndisturb that client's polling session (socketio-next drops those keys now).",[180,245,247],{"id":246},"fixed","Fixed",[185,249,250,261],{},[188,251,252,253,256,257,260],{},"The clients a webview connected are disconnected when its window is destroyed (a reload keeps\nthem), and one webview may have at most ",[139,254,255],{},"MAX_CLIENTS_PER_WEBVIEW"," (64) at once\n(",[139,258,259],{},"TooManyClients","); before, a loop of connect + close left every client connected.",[188,262,263,264,267,268,271],{},"A ",[139,265,266],{},"reconnect"," racing a ",[139,269,270],{},"disconnect"," revived a client that was already unregistered; the\nrevived connection is closed again and the id reported unknown.",[180,273,275],{"id":274},"fixed-guest-js","Fixed (guest-js)",[185,277,278,299,302,311,324,339],{},[188,279,280,283,284,287,288,291,292,283,295,298],{},[139,281,282],{},"connect()"," \u002F ",[139,285,286],{},"attach()",": the messages that came before the call resolved are held until the\nsubscription's snapshot arrived, not for one fixed tick; a large event ahead of the snapshot\n(Tauri sends it by ",[139,289,290],{},"fetch",") made stale ",[139,293,294],{},"connecting",[139,296,297],{},"connected"," states fire again.",[188,300,301],{},"A throwing listener no longer stops the other listeners or the later messages; the error is\nrethrown on its own.",[188,303,304,307,308,163],{},[139,305,306],{},"off(event, fn)"," removes a listener added with ",[139,309,310],{},"once(event, fn)",[188,312,313,283,316,319,320,323],{},[139,314,315],{},"Blob",[139,317,318],{},"File"," arguments are read and sent as binary (they went out as ",[139,321,322],{},"{}",").",[188,325,326,327,330,331,334,335,338],{},"After ",[139,328,329],{},"disconnect()"," the socket reports ",[139,332,333],{},"closed"," (",[139,336,337],{},"io client disconnect",") right away.",[188,340,341],{},"A failed ack answer (expired, or answered by another socket of the webview) is logged instead\nof an unhandled promise rejection.",[180,343,345],{"id":344},"added-guest-js","Added (guest-js)",[185,347,348],{},[188,349,350,208,353,355,356,359],{},[139,351,352],{},"connect",[139,354,270],{}," (with the reason) and ",[139,357,358],{},"connect_error"," events from the state\ntransitions, as socket.io-client emits them.",[180,361,183],{"id":362},"changed-1",[185,364,365,373,383,390],{},[188,366,367,368,372],{},"Documentation at ",[151,369,370],{"href":370,"rel":371},"https:\u002F\u002Fs00d.github.io\u002Frust-socketio\u002Ftauri\u002Fsetup",[155],"; the README is short\nand links to it.",[188,374,375,376,379,380,323],{},"guest-js exports the ",[139,377,378],{},"WireArgs"," type (the return type of ",[139,381,382],{},"encodeArgs",[188,384,385,386,389],{},"guest-js needs ",[139,387,388],{},"@tauri-apps\u002Fapi"," 2.12.3 or newer (earlier versions stop a channel after a\nthrowing callback and leak channel callbacks).",[188,391,392,393,208,396,208,399,402,403,406],{},"Connect options in milliseconds (",[139,394,395],{},"timeout",[139,397,398],{},"reconnectionDelay",[139,400,401],{},"reconnectionDelayMax",") are\nread like ",[139,404,405],{},"emitWithAck","'s timeout: a fraction is cut (it was refused), a negative is refused.",[165,408,410,413],{"id":409},"_010-2026-11-08",[169,411,412],{},"0.1.0"," - 2026-11-08",[180,415,417],{"id":416},"added","Added",[185,419,420,423,471,528,531,538,544,557,566,580,586,618,656,675,688,700,711,718,728],{},[188,421,422],{},"First release: a registry of named socketio-next clients shared by Rust and the webviews.",[188,424,425,426,429,430,433,434,208,436,334,439,442,443,446,447,208,450,208,453,208,456,459,460,442,463,466,467,470],{},"Rust: ",[139,427,428],{},"SocketIoExt::socketio()"," → ",[139,431,432],{},"SocketIo"," with ",[139,435,352],{},[139,437,438],{},"insert",[139,440,441],{},"Access::Full"," \u002F\n",[139,444,445],{},"Access::ReadOnly","), ",[139,448,449],{},"get",[139,451,452],{},"access",[139,454,455],{},"ids",[139,457,458],{},"remove"," (never disconnects), ",[139,461,462],{},"subscribe",[139,464,465],{},"unsubscribe",". Ids are unique (",[139,468,469],{},"AlreadyExists",", no silent replacement).",[188,472,473,474,208,476,208,479,482,483,433,486,208,489,208,491,283,494,283,497,442,500,283,503,208,506,208,509,208,512,208,514,208,516,208,519,208,521,524,525,163],{},"JS: ",[139,475,352],{},[139,477,478],{},"attach",[139,480,481],{},"list","; ",[139,484,485],{},"Socket",[139,487,488],{},"emit",[139,490,405],{},[139,492,493],{},"on",[139,495,496],{},"once",[139,498,499],{},"off",[139,501,502],{},"onAny",[139,504,505],{},"offAny",[139,507,508],{},"onState",[139,510,511],{},"state",[139,513,242],{},[139,515,297],{},[139,517,518],{},"id",[139,520,270],{},[139,522,523],{},"close",";\ntyped ",[139,526,527],{},"SocketIoError { kind, message, data }",[188,529,530],{},"Per-subscription IPC channels (ordered, per webview) with an optional event filter; ended on\nunsubscribe, on a failed send, when the webview loads a new page or its window is destroyed,\nand when the client is removed.",[188,532,533,534,537],{},"Server acks answered from JS: one ",[139,535,536],{},"ackId"," per server ack for every subscribed webview,\nanswered once; 2 min TTL and a budget per webview; not offered for read-only clients or once a\ndisconnect started.",[188,539,540,543],{},[139,541,542],{},"SocketIo::reserve(id)",": ids Rust registers later cannot be taken by a page script.",[188,545,546,549,550,553,554,163],{},[139,547,548],{},"Builder::allow_url_prefix",": URL allow-list for webview connects (the CSP does not cover\nthese sockets); ",[139,551,552],{},"init()"," is ",[139,555,556],{},"Builder::new().build()",[188,558,559,560,215,562,565],{},"Webview isolation: ",[139,561,465],{},[139,563,564],{},"ack"," act only on the caller's subscriptions and acks;\nat most 64 subscriptions per webview.",[188,567,568,283,570,572,573,575,576,579],{},[139,569,352],{},[139,571,478],{}," resolve with the current state (the socket is ",[139,574,297],{}," right away);\nthe channel starts with that snapshot (",[139,577,578],{},"snapshot: true",") and nothing older follows it.",[188,581,582,583,585],{},"One forwarding hub per client: ending a subscription drops its channel; a reload during a\nJS ",[139,584,352],{}," leaves no subscription behind.",[188,587,588,283,591,283,594,597,598,208,601,208,604,607,608,610,611,613,614,617],{},[139,589,590],{},"setAuth",[139,592,593],{},"setHeaders",[139,595,596],{},"setQuery"," (commands ",[139,599,600],{},"set_auth",[139,602,603],{},"set_headers",[139,605,606],{},"set_query",") for\nclients a webview connected, read before every connect attempt; ",[139,609,266],{}," after ",[139,612,333],{},";\na ",[139,615,616],{},"ca"," option (PEM) for private CAs.",[188,619,620,622,623,283,626,208,629,283,632,208,635,482,638,641,642,433,645,648,649,652,653,163],{},[139,621,242],{}," has ",[139,624,625],{},"packetsIn",[139,627,628],{},"packetsOut",[139,630,631],{},"bytesIn",[139,633,634],{},"bytesOut",[139,636,637],{},"sessions",[139,639,640],{},"disconnected","\nstates carry the error (",[139,643,644],{},"WebsocketClosed",[139,646,647],{},"data: { code, reason }","); ",[139,650,651],{},"HttpStatus","\nerrors have ",[139,654,655],{},"data.message",[188,657,658,659,661,662,208,665,208,668,208,671,674],{},"The URL allow-list checks the engine.io path the connection uses (not the URL path, which\nis the namespace); concurrent connects hold their id and subscription slot, so they cannot\npass the per-webview cap; ",[139,660,266],{}," only for clients a webview connected; headers the\nwebview may not set (",[139,663,664],{},"Host",[139,666,667],{},"Cookie",[139,669,670],{},"Sec-WebSocket-*",[139,672,673],{},"Proxy-*",", ...).",[188,676,677,678,208,681,684,685,163],{},"The URL allow-list compares the URL socketio-next really builds (dot segments resolved) and\nrefuses ",[139,679,680],{},"..",[139,682,683],{},"%2e"," and backslashes in ",[139,686,687],{},"path",[188,689,690,215,693,696,697,163],{},[139,691,692],{},"State",[139,694,695],{},"Message"," and their struct-like variants are ",[139,698,699],{},"#[non_exhaustive]",[188,701,702,703,706,707,710],{},"Typed ",[139,704,705],{},"InvalidOptions"," for wrong option types\u002Fvalues (values are not echoed); connect\noptions' ",[139,708,709],{},"Debug"," hides query, header and auth values.",[188,712,713,714,717],{},"Binary arguments both ways (",[139,715,716],{},"Uint8Array"," ↔ socket.io attachments).",[188,719,720,721,724,725,163],{},"Permissions per command, ",[139,722,723],{},"socketio:allow-read"," (observe only) and ",[139,726,727],{},"socketio:default",[188,729,730,731,734,735,738],{},"Features ",[139,732,733],{},"rustls"," (default) and ",[139,736,737],{},"native-tls",", forwarded to socketio-next.",{"title":740,"searchDepth":741,"depth":742,"links":743},"",2,3,[744,745,749,757],{"id":167,"depth":741,"text":171},{"id":174,"depth":741,"text":746,"children":747},"0.2.1 - 2026-11-21",[748],{"id":182,"depth":742,"text":183},{"id":193,"depth":741,"text":750,"children":751},"0.2.0 - 2026-11-21",[752,753,754,755,756],{"id":199,"depth":742,"text":88},{"id":246,"depth":742,"text":247},{"id":274,"depth":742,"text":275},{"id":344,"depth":742,"text":345},{"id":362,"depth":742,"text":183},{"id":409,"depth":741,"text":758,"children":759},"0.1.0 - 2026-11-08",[760],{"id":416,"depth":742,"text":417},"All notable changes to tauri-plugin-socketio and tauri-plugin-socketio-api.","md",null,{},true,{"title":104,"description":761},"LlyULvTP59RxnvUjbh9kDslOK4JeQvq1zWJxiFa0w_c",[769,771],{"title":100,"path":101,"stem":102,"description":770,"children":-1},"A Tauri app with a read-only client owned by Rust and a client of the webview.",{"title":114,"path":115,"stem":116,"description":772,"children":-1},"What changed from rust_socketio 0.6, the fixes and additions, and a mapping table.",1795288423683]