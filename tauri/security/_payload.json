167,168,171,172,175],"p",{},"Rust usually registers its clients after an ",[144,145,146],"code",{},"await"," (the connect). Until then any page script with ",[144,149,150],{},"allow-connect"," could ",[144,153,154],{},"connect"," under the same id, and Rust's ",[144,157,158],{},"insert"," would fail with ",[144,161,162],{},"AlreadyExists"," while ",[144,165,166],{},"get(id)"," returned the page's client. Call ",[144,169,170],{},"reserve(id)"," in ",[144,173,174],{},"setup",", synchronously:",[177,178,183],"pre",{"className":179,"code":180,"language":181,"meta":182,"style":182},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight",".setup(|app| {\n    app.socketio().reserve(\"core\");\n    Ok(())\n})\n","rust","",[144,184,185,210,242,252],{"__ignoreMap":182},[186,187,190,194,197,200,204,207],"span",{"class":188,"line":189},"line",1,[186,191,193],{"class":192},"sMK4o",".",[186,195,174],{"class":196},"s2Zo4",[186,198,199],{"class":192},"(|",[186,201,203],{"class":202},"sTEyZ","app",[186,205,206],{"class":192},"|",[186,208,209],{"class":192}," {\n",[186,211,213,216,218,221,224,227,230,233,237,239],{"class":188,"line":212},2,[186,214,215],{"class":202},"    app",[186,217,193],{"class":192},[186,219,220],{"class":196},"socketio",[186,222,223],{"class":192},"().",[186,225,226],{"class":196},"reserve",[186,228,229],{"class":192},"(",[186,231,232],{"class":192},"\"",[186,234,236],{"class":235},"sfazB","core",[186,238,232],{"class":192},[186,240,241],{"class":192},");\n",[186,243,245,249],{"class":188,"line":244},3,[186,246,248],{"class":247},"sBMFI","    Ok",[186,250,251],{"class":192},"(())\n",[186,253,255],{"class":188,"line":254},4,[186,256,257],{"class":192},"})\n",[135,259,261],{"id":260},"read-only-clients","Read-only clients",[140,263,264,265,268,269,272,273,272,276,279,280,283,284,287,288,193],{},"Register clients the webview must not drive with ",[144,266,267],{},"Access::ReadOnly",": ",[144,270,271],{},"emit",", ",[144,274,275],{},"emitWithAck",[144,277,278],{},"ack"," and ",[144,281,282],{},"disconnect"," are refused from every webview with ",[144,285,286],{},"AccessDenied",", whatever the capabilities allow. See ",[289,290,80],"a",{"href":291},"\u002Ftauri\u002Frust-api#read-only-clients",[135,293,295],{"id":294},"url-allow-list","URL allow-list",[140,297,298,299,302,303,305],{},"The sockets run in Rust, so the webview's CSP (",[144,300,301],{},"connect-src",") does not limit them: with ",[144,304,150],{}," a page can reach any host with any headers. Restrict it:",[177,307,309],{"className":179,"code":308,"language":181,"meta":182,"style":182},".plugin(\n    tauri_plugin_socketio::Builder::new()\n        .allow_url_prefix(\"https:\u002F\u002Fapi.example.com\")       \u002F\u002F scheme + host + port\n        .allow_url_prefix(\"wss:\u002F\u002Frt.example.com\u002Fv1\u002F\")      \u002F\u002F ... and a path prefix\n        .build(),\n)\n",[144,310,311,321,340,364,384,395],{"__ignoreMap":182},[186,312,313,315,318],{"class":188,"line":189},[186,314,193],{"class":192},[186,316,317],{"class":196},"plugin",[186,319,320],{"class":192},"(\n",[186,322,323,326,329,332,334,337],{"class":188,"line":212},[186,324,325],{"class":247},"    tauri_plugin_socketio",[186,327,328],{"class":192},"::",[186,330,331],{"class":247},"Builder",[186,333,328],{"class":192},[186,335,336],{"class":196},"new",[186,338,339],{"class":192},"()\n",[186,341,342,345,348,350,352,355,357,360],{"class":188,"line":244},[186,343,344],{"class":192},"        .",[186,346,347],{"class":196},"allow_url_prefix",[186,349,229],{"class":192},[186,351,232],{"class":192},[186,353,354],{"class":235},"https:\u002F\u002Fapi.example.com",[186,356,232],{"class":192},[186,358,359],{"class":192},")",[186,361,363],{"class":362},"sHwdD","       \u002F\u002F scheme + host + port\n",[186,365,366,368,370,372,374,377,379,381],{"class":188,"line":254},[186,367,344],{"class":192},[186,369,347],{"class":196},[186,371,229],{"class":192},[186,373,232],{"class":192},[186,375,376],{"class":235},"wss:\u002F\u002Frt.example.com\u002Fv1\u002F",[186,378,232],{"class":192},[186,380,359],{"class":192},[186,382,383],{"class":362},"      \u002F\u002F ... and a path prefix\n",[186,385,387,389,392],{"class":188,"line":386},5,[186,388,344],{"class":192},[186,390,391],{"class":196},"build",[186,393,394],{"class":192},"(),\n",[186,396,398],{"class":188,"line":397},6,[186,399,400],{"class":192},")\n",[140,402,403,404,408,409,412,413,416,417,420,421,424,425,272,428,431,432,435,436,193],{},"What is enforced: the scheme, the host, the port, and the ",[405,406,407],"strong",{},"engine.io path"," (the ",[144,410,411],{},"path"," option, default ",[144,414,415],{},"\u002Fsocket.io\u002F",") under the prefix's path on a ",[144,418,419],{},"\u002F"," boundary. The URL's own path is the namespace and is not part of the check, nor is the ",[144,422,423],{},"namespace"," option. Query and headers changed later (",[144,426,427],{},"setQuery",[144,429,430],{},"setHeaders",") and ",[144,433,434],{},"reconnect"," cannot move the target. A refused URL rejects with ",[144,437,438],{},"UrlNotAllowed",[140,440,441,442,444,445,448,449,451,452,454],{},"Without ",[144,443,347],{}," every URL is allowed (",[144,446,447],{},"init()","). Rust's ",[144,450,154],{}," \u002F ",[144,453,158],{}," are never restricted.",[135,456,458],{"id":457},"headers","Headers",[140,460,461,462,272,465,272,468,272,471,272,474,272,477,480,481,279,484,487,488,491,492,494],{},"Headers from the webview are limited: ",[144,463,464],{},"Host",[144,466,467],{},"Connection",[144,469,470],{},"Upgrade",[144,472,473],{},"Content-Length",[144,475,476],{},"Transfer-Encoding",[144,478,479],{},"Cookie"," (cookies come from the jar), ",[144,482,483],{},"Sec-WebSocket-*",[144,485,486],{},"Proxy-*"," are refused with ",[144,489,490],{},"InvalidOptions"," naming the header, in the connect options and in ",[144,493,430],{},". Rust's clients are not limited.",[135,496,50],{"id":497},"tls",[140,499,500,501,504],{},"The ",[144,502,503],{},"ca"," option adds trusted certificates for a private CA; there is no option to turn certificate checks off.",[135,506,508],{"id":507},"webview-isolation","Webview isolation",[140,510,511,279,514,516,517,520,521,524,525,528,529,532],{},[144,512,513],{},"unsubscribe",[144,515,278],{}," act only on the calling webview's subscriptions and on acks offered to it (",[144,518,519],{},"UnknownAck"," otherwise). A webview has at most ",[144,522,523],{},"MAX_SUBSCRIPTIONS_PER_WEBVIEW"," (64) subscriptions (",[144,526,527],{},"TooManySubscriptions",") and, per client, at most ",[144,530,531],{},"MAX_PENDING_ACKS_PER_WEBVIEW"," (256) unanswered server acks; past that its own oldest ack is forgotten, never another webview's.",[135,534,536],{"id":535},"least-privilege","Least privilege",[140,538,539,540,543,544,547],{},"Grant ",[144,541,542],{},"socketio:allow-read"," instead of ",[144,545,546],{},"socketio:default"," to windows that only observe.",[549,550,551],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-we