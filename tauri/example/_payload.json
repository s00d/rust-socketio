ht","import { attach, connect, SocketIoError } from 'tauri-plugin-socketio-api'\n\n\u002F\u002F A client Rust registered as read-only: observe it, emitting is refused.\nlet core\nfor (;;) {\n  try {\n    core = await attach('core', { events: ['tock'] })\n    break\n  } catch (e) {\n    if (!(e instanceof SocketIoError && e.kind === 'UnknownClient')) throw e\n    await new Promise((r) => setTimeout(r, 500))\n  }\n}\ncore.on('tock', (n, text) => console.log('tock', n, text))\n\n\u002F\u002F A client of this webview: connect, or after a reload take over the registered one.\nconst chat = await connect('chat', { url: URL, reconnectionDelay: 500 }).catch(async (e) => {\n  if (e instanceof SocketIoError && e.kind === 'AlreadyExists') return attach('chat')\n  throw e\n})\nchat.on('echo-back', (...args) => console.log('echo-back', ...args))\n","src\u002Fmain.ts","ts",[144,696,697,733,739,744,752,769,776,827,832,848,896,934,939,943,1002,1006,1011,1077,1124,1131,1137],{"__ignoreMap":167},[171,698,699,702,705,708,710,713,715,718,721,724,727,730],{"class":173,"line":174},[171,700,701],{"class":447},"import",[171,703,704],{"class":185}," {",[171,706,707],{"class":316}," attach",[171,709,527],{"class":185},[171,711,712],{"class":316}," connect",[171,714,527],{"class":185},[171,716,717],{"class":316}," SocketIoError",[171,719,720],{"class":185}," }",[171,722,723],{"class":447}," from",[171,725,726],{"class":185}," '",[171,728,729],{"class":181},"tauri-plugin-socketio-api",[171,731,732],{"class":185},"'\n",[171,734,735],{"class":173,"line":199},[171,736,738],{"emptyLinePlaceholder":737},true,"\n",[171,740,741],{"class":173,"line":209},[171,742,743],{"class":195},"\u002F\u002F A client Rust registered as read-only: observe it, emitting is refused.\n",[171,745,746,749],{"class":173,"line":286},[171,747,748],{"class":392},"let",[171,750,751],{"class":316}," core\n",[171,753,754,757,760,763,766],{"class":173,"line":292},[171,755,756],{"class":447},"for",[171,758,759],{"class":316}," (",