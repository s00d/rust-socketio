le":72,"path":73,"stem":74},"Setup","\u002Ftauri\u002Fsetup","3.tauri\u002F1.setup",{"title":76,"path":77,"stem":78},"JavaScript API","\u002Ftauri\u002Fjavascript-api","3.tauri\u002F2.javascript-api",{"title":80,"path":81,"stem":82},"Rust API","\u002Ftauri\u002Frust-api","3.tauri\u002F3.rust-api",{"title":84,"path":85,"stem":86},"Permissions","\u002Ftauri\u002Fpermissions","3.tauri\u002F4.permissions",{"title":88,"path":89,"stem":90},"Security","\u002Ftauri\u002Fsecurity","3.tauri\u002F5.security",{"title":92,"path":93,"stem":94},"Messages and errors","\u002Ftauri\u002Fmessages-and-errors","3.tauri\u002F6.messages-and-errors",{"title":96,"path":97,"stem":98},"Troubleshooting","\u002Ftauri\u002Ftroubleshooting","3.tauri\u002F7.troubleshooting",{"title":100,"path":101,"stem":102},"Example app","\u002Ftauri\u002Fexample","3.tauri\u002F8.example",{"title":104,"path":105,"stem":106},"Plugin changelog","\u002Ftauri\u002Fchangelog","3.tauri\u002F9.changelog",{"title":108,"icon":109,"path":110,"stem":111,"children":112,"page":26},"Guides","i-lucide-book-open","\u002Fguides","4.guides",[113,117,121],{"title":114,"path":115,"stem":116},"Migration from rust_socketio","\u002Fguides\u002Fmigration","4.guides\u002F1.migration",{"title":118,"path":119,"stem":120},"Comparison","\u002Fguides\u002Fcomparison","4.guides\u002F2.comparison",{"title":122,"path":123,"stem":124},"Contributing","\u002Fguides\u002Fcontributing","4.guides\u002F3.contributing",{"title":126,"path":127,"stem":128},"Changelog","\u002Fchangelog","9.changelog",{"id":130,"title":126,"body":131,"description":697,"extension":698,"links":699,"meta":700,"navigation":701,"path":127,"seo":702,"stem":128,"__hash__":703},"docs\u002F9.changelog.md",{"type":132,"value":133,"toc":682},"minimark",[134,138,155,163,168,180,187,201,205,448,451,560,564,652,656],[135,136,137],"p",{},"All notable changes to this project will be documented in this file.",[135,139,140,141,148,149,154],{},"The format is based on ",[142,143,147],"a",{"href":144,"rel":145},"https:\u002F\u002Fkeepachangelog.com\u002Fen\u002F1.1.0\u002F",[146],"nofollow","Keep a Changelog",",\nand this project adheres to ",[142,150,153],{"href":151,"rel":152},"https:\u002F\u002Fsemver.org\u002Fspec\u002Fv2.0.0.html",[146],"Semantic Versioning",".",[156,157,159],"h2",{"id":158},"unreleased",[160,161,162],"span",{},"Unreleased",[164,165,167],"h3",{"id":166},"changed","Changed",[169,170,171],"ul",{},[172,173,174,175,179],"li",{},"Documentation site at ",[142,176,177],{"href":177,"rel":178},"https:\u002F\u002Fs00d.github.io\u002Frust-socketio\u002F",[146],"; the README is short and links\nto it.",[156,181,183,186],{"id":182},"_010-2026-11-08",[160,184,185],{},"0.1.0"," - 2026-11-08",[135,188,189,190,194,195,200],{},"First release of ",[191,192,193],"code",{},"socketio-next",", the successor of the s00d\u002Frust-socketio fork of\n",[142,196,199],{"href":197,"rel":198},"https:\u002F\u002Fgithub.com\u002F1c3t3a\u002Frust-socketio",[146],"rust_socketio"," 0.6.0 (its history is in that\nrepository). See \"Differences from rust_socketio\" in the README for the migration table.",[164,202,204],{"id":203},"added","Added",[169,206,207,218,257,264,275,293,299,312,315,330,343,351,357,383,389,395,409,427],{},[172,208,209,210,213,214,217],{},"One crate: the socket.io client, ",[191,211,212],{},"engineio"," (transport layer) and ",[191,215,216],{},"protocol"," (codecs, no I\u002FO).",[172,219,220,221,224,225,224,228,231,232,235,236,224,239,224,242,224,245,248,249,252,253,256],{},"Socket.IO client with socket.io-client 4.8 behaviour: connection task + ordered event task,\n",[191,222,223],{},"ConnectionState"," \u002F ",[191,226,227],{},"DisconnectReason",[191,229,230],{},"LinkInfo",", awaitable acks with timeout, server acks\nanswered (",[191,233,234],{},"Event::ack","), runtime ",[191,237,238],{},"on",[191,240,241],{},"once",[191,243,244],{},"on_any",[191,246,247],{},"off",", sync or async handlers\nwithout boxing, ",[191,250,251],{},"buffer_while_disconnected"," (opt-in send buffer), connection state recovery,\n",[191,254,255],{},"auth_with",", query and headers, packet inspector, typed cloneable errors.",[172,258,259,260,263],{},"socket.io-parser binary encoding: several attachments, nested placeholders (",[191,261,262],{},"Payload::Mixed",");\nmaxAttachments 10; numeric and argument-less event names.",[172,265,266,267,270,271,274],{},"socket.io-client reconnection backoff (backo2, randomizationFactor 0.5, delay before every\nattempt); ",[191,268,269],{},"reconnection_attempts"," is final (",[191,272,273],{},"ReconnectFailed",").",[172,276,277,278,281,282,285,286,289,290,154],{},"TLS as a feature: ",[191,279,280],{},"rustls"," (default, ring + webpki roots), ",[191,283,284],{},"native-tls",", or none; ",[191,287,288],{},"TlsConfig","\nwith ",[191,291,292],{},"with_root_certificates_pem",[172,294,295,298],{},[191,296,297],{},"blocking"," feature: the async client on a private runtime.",[172,300,301,304,305,308,309,274],{},[191,302,303],{},"TlsProviderMissing"," instead of a reqwest panic when another crate enabled reqwest's\n",[191,306,307],{},"rustls-no-provider"," (found integrating with a Tauri app using ",[191,310,311],{},"tauri-plugin-updater",[172,313,314],{},"tracing with spans per client and redacted query values; errors never carry URLs.",[172,316,317,318,321,322,325,326,329],{},"Differential tests against socket.io-client 4.8 (",[191,319,320],{},"ci\u002Fconformance","), Node test servers without\nDocker (",[191,323,324],{},"ci\u002Fservers.sh","), ",[191,327,328],{},"justfile",", CI on Linux, macOS and Windows.",[172,331,332,335,336,339,340,154],{},[191,333,334],{},"tauri-plugin-socketio"," (crate) and ",[191,337,338],{},"tauri-plugin-socketio-api"," (npm): a Tauri 2 plugin with\nnamed clients shared by Rust and the webviews; its own changelog is\n",[142,341,342],{"href":105},"crates\u002Ftauri-plugin-socketio\u002FCHANGELOG.md",[172,344,345,348,349,154],{},[191,346,347],{},"ClientBuilder::connect_params_with",": query parameters and headers computed before every\nconnect attempt (inside its timeout, panics contained), like ",[191,350,255],{},[172,352,353,356],{},[191,354,355],{},"Client::reconnect()"," (and blocking): connect a closed client again with the same handlers.",[172,358,359,362,363,224,366,224,369,224,372,375,376,379,380,154],{},[191,360,361],{},"ClientBuilder::proxy(..)"," and ",[191,364,365],{},"HTTPS_PROXY",[191,367,368],{},"HTTP_PROXY",[191,370,371],{},"ALL_PROXY",[191,373,374],{},"NO_PROXY"," for the\nwebsocket too (a ",[191,377,378],{},"CONNECT"," tunnel with basic auth); ",[191,381,382],{},"engineio::Error::ProxyFailed",[172,384,385,388],{},[191,386,387],{},"cookies"," feature: one cookie jar per client for polling and the websocket handshake.",[172,390,391,394],{},[191,392,393],{},"platform-verifier"," feature: rustls with the OS trust store (not on Android).",[172,396,397,400,401,404,405,408],{},[191,398,399],{},"engineio::Error::WebsocketClosed { code, reason }"," from close frames (also during the\nupgrade probe), a ",[191,402,403],{},"TransportClose","; ",[191,406,407],{},"ConnectionState::Disconnected"," carries the error.",[172,410,411,414,415,418,419,422,423,426],{},[191,412,413],{},"HttpStatus"," has engine.io's error message (",[191,416,417],{},"message",") when the body is its\n",[191,420,421],{},"{\"code\", \"message\"}"," JSON (at most 4 KiB read, 200 characters kept, URLs and queries\nremoved); any other body (HTML, text, other JSON) gives ",[191,424,425],{},"None",", since it may echo the\nrequest, a header or a token.",[172,428,429,431,432,224,435,438,439,224,442,438,445,154],{},[191,430,230],{},": ",[191,433,434],{},"packets_in",[191,436,437],{},"packets_out",", ",[191,440,441],{},"bytes_in",[191,443,444],{},"bytes_out",[191,446,447],{},"sessions",[164,449,167],{"id":450},"changed-1",[169,452,453,493,528,534,537,548,551,557],{},[172,454,455,456,458,459,462,463,466,467,469,470,438,472,438,475,477,478,481,482,485,486,489,490,492],{},"Breaking (pre-release): ",[191,457,407],{}," has an ",[191,460,461],{},"error"," field and\n",[191,464,465],{},"engineio::Error::HttpStatus"," a ",[191,468,417],{}," field; the struct-like variants of\n",[191,471,223],{},[191,473,474],{},"Error::ConnectRejected",[191,476,465],{}," and\n",[191,479,480],{},"WebsocketClosed"," are ",[191,483,484],{},"#[non_exhaustive]"," (match them with ",[191,487,488],{},"..","), so fields can be added\nlater without a break. Code ported from rust_socketio matches states with ",[191,491,488],{}," anyway.",[172,494,495,496,438,498,438,500,438,502,504,505,508,509,511,512,515,516,519,520,523,524,527],{},"Environment proxies (",[191,497,365],{},[191,499,368],{},[191,501,371],{},[191,503,374],{},") now also apply to\nthe websocket, ",[191,506,507],{},"ws:\u002F\u002F"," included, with the same matcher reqwest uses for polling; a proxy that\nrefuses ",[191,510,378],{}," to non-443 ports refuses the websocket (with ",[191,513,514],{},"TransportType::Any"," the client\nstays on polling). ",[191,517,518],{},"ClientBuilder::no_proxy()"," turns proxies off for both transports.\n",[191,521,522],{},"https:\u002F\u002F"," and SOCKS proxies are a ",[191,525,526],{},"ProxyFailed"," error for the websocket.",[172,529,530,531,533],{},"Redirects are not followed (a 3xx is an ",[191,532,413],{}," error without the target).",[172,535,536],{},"The wall-clock check of the heartbeat probes the link and waits pingTimeout instead of\nclosing at once, so an NTP step on a live link does not disconnect.",[172,538,539,540,543,544,547],{},"A refused websocket handshake (3xx, 4xx) is ",[191,541,542],{},"HttpStatus { status }","; the response (with a\n",[191,545,546],{},"Location"," that may carry the query) is not kept in the error.",[172,549,550],{},"Environment proxies are read once, when the client is built; both transports use that\ndecision for the client's life.",[172,552,553,556],{},[191,554,555],{},"ClientBuilder::engine_url()",": the engine.io URL a connect will use (path normalized).",[172,558,559],{},"One reqwest client per socket.io client, shared by every transport and reconnect (it was\ntwo per connect attempt); only long-poll GETs are bounded by pingInterval + pingTimeout, so\nslow POST uploads are no longer cut.",[164,561,563],{"id":562},"fixed","Fixed",[169,565,566,569,572,575,585,599,608,641],{},[172,567,568],{},"The heartbeat also checks the wall clock: after a system sleep a dead link is detected on\nwake-up instead of after the remaining monotonic time.",[172,570,571],{},"The websocket reader could miss a wakeup when another task held the receiver (a lock\nfuture polled once and dropped); the receiver is now polled under a short std lock.",[172,573,574],{},"The wall-clock liveness probe over polling goes through the normal write lock (a POST\nnext to another one made engine.io close the session with \"data request overlap\").",[172,576,577,580,581,584],{},[191,578,579],{},"reconnect()"," racing ",[191,582,583],{},"disconnect()",": a disconnect always wins (no revived client, no hang).",[172,586,587,588,591,592,595,596,598],{},"The caller's ",[191,589,590],{},"Cookie"," header and the cookie jar are merged (",[191,593,594],{},"user; jar",") on polling and on\nthe websocket handshake (",[191,597,387],{}," feature).",[172,600,601,602,604,605,274],{},"IPv6 servers and proxies through the ",[191,603,378],{}," tunnel (",[191,606,607],{},"[::1]",[172,609,610,613,614,617,618,621,622,438,625,628,629,632,633,636,637,640],{},[191,611,612],{},"connect().await"," could return before the client was connected: ",[191,615,616],{},"connected()"," false,\n",[191,619,620],{},"state()"," ",[191,623,624],{},"Connecting",[191,626,627],{},"id()"," None and ",[191,630,631],{},"emit()"," failing with ",[191,634,635],{},"NotConnected"," on a\nmulti-thread runtime or with the blocking client. The connected state is now set before\n",[191,638,639],{},"connect()"," returns and after every reconnect.",[172,642,643,644],{},"Carried over from the fork, each with a regression test:",[169,645,646],{},[172,647,648,649,651],{},"Whole long-polling bodies; bounded handshakes; non-200 polling answers; websocket frames as\nsingle packets; unique ack ids; ",[191,650,583],{}," stops reconnects and hung attempts; the engine\ncloses after namespace disconnect, CONNECT_ERROR and decode errors; emits before CONNECT are\nbuffered; BINARY_EVENT for binary emits with ack; socket.io-parser validation rules; no\nunsolicited PONG.",[164,653,655],{"id":654},"removed","Removed",[169,657,658],{},[172,659,660,661,664,665,438,668,671,672,438,675,678,679,681],{},"The sync engine.io client and transports; ",[191,662,663],{},"Payload::String","; the ",[191,666,667],{},"backoff",[191,669,670],{},"adler32",",\n",[191,673,674],{},"async-stream",[191,676,677],{},"async-trait"," and direct ",[191,680,284],{}," dependencies.",{"title":683,"searchDepth":684,"depth":685,"links":686},"",2,3,[687,690],{"id":158,"depth":684,"text":162,"children":688},[689],{"id":166,"depth":685,"text":167},{"id":182,"depth":684,"text":691,"children":692},"0.1.0 - 2026-11-08",[693,694,695,696],{"id":203,"depth":685,"text":204},{"id":450,"depth":685,"text":167},{"id":562,"depth":685,"text":563},{"id":654,"depth":685,"text":655},"All notable changes to socketio-next.","md",null,{},true,{"title":126,"description":697},"mOTttr_rnJIz0D6scpu_f1HxkD6zqUtTmWDZMGEK8OQ",[705,699],{"title":122,"path":123,"stem":124,"description":706,"children":-1},"The justfile, the Node test servers, CI and the docs site.",1794148411160]