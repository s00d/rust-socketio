{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "socketio-example",
  "version": "0.0.0",
  "identifier": "com.s00d.socketio.example",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "tauri-plugin-socketio", "width": 800, "height": 700 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
