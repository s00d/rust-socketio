{
  "name": "tauri-plugin-socketio-api",
  "version": "0.1.0",
  "author": "Pavel Kuzmin",
  "description": "JS API of tauri-plugin-socketio: named Socket.IO clients shared by Rust (socketio-next) and the webview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/rust-socketio.git",
    "directory": "crates/tauri-plugin-socketio"
  },
  "homepage": "https://github.com/s00d/rust-socketio/tree/main/crates/tauri-plugin-socketio",
  "license": "MIT",
  "keywords": [
    "tauri",
    "tauri-plugin",
    "socket.io",
    "socketio",
    "websocket",
    "realtime"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-js/index.d.ts",
        "default": "./dist-js/index.js"
      },
      "require": {
        "types": "./dist-js/index.d.cts",
        "default": "./dist-js/index.cjs"
      }
    }
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('dist-js/index.d.ts','dist-js/index.d.cts')\" && pnpm check:dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "check:dist": "publint --strict && attw --pack . --profile node16 && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "engines": {
    "node": ">=20.19"
  }
}
