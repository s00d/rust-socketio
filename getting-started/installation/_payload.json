features","Cargo features",[274,275,276,292],"table",{},[277,278,279],"thead",{},[280,281,282,286,289],"tr",{},[283,284,285],"th",{},"Feature",[283,287,288],{},"Default",[283,290,291],{},"What",[293,294,295,313,326,342,354],"tbody",{},[280,296,297,303,306],{},[298,299,300],"td",{},[143,301,302],{},"rustls",[298,304,305],{},"yes",[298,307,308,309,312],{},"TLS with rustls (ring provider, Mozilla roots from ",[143,310,311],{},"webpki-roots","). Pure Rust: no OpenSSL, builds for Android and iOS.",[280,314,315,320,323],{},[298,316,317],{},[143,318,319],{},"native-tls",[298,321,322],{},"no",[298,324,325],{},"TLS with the platform library: OpenSSL on Linux, Security.framework on macOS, SChannel on Windows.",[280,327,328,333,335],{},[298,329,330],{},[143,331,332],{},"platform-verifier",[298,334,322],{},[298,336,337,338,341],{},"rustls checks certificates with the operating system's trust store (enterprise and user-installed CAs) through ",[143,339,340],{},"rustls-platform-verifier",", instead of the bundled Mozilla roots. Not on Android (it needs JVM setup there), which keeps the bundled roots.",[280,343,344,349,351],{},[298,345,346],{},[143,347,348],{},"cookies",[298,350,322],{},[298,352,353],{},"One cookie jar per client: cookies set by polling answers go back on later requests and on the websocket handshake (sticky sessions behind a load balancer).",[280,355,356,361,363],{},[298,357,358],{},[143,359,360],{},"blocking",[298,362,322],{},[298,364,365,371],{},[366,367,368],"a",{"href":63},[143,369,370],{},"socketio_next::blocking",": the same client with blocking methods and plain-closure handlers.",[135,373,375],{"className":137,"code":374,"language":140,"meta":141,"style":141},"# native-tls instead of rustls\nsocketio-next = { version = \"0.1\", default-features = false, features = [\"native-tls\"] }\n\n# rustls with the OS trust store, cookies and the blocking API\nsocketio-next = { version = \"0.1\", features = [\"platform-verifier\", \"cookies\", \"blocking\"] }\n",[143